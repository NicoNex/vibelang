mod Taint

ext c "stdio.h"
  puts : &CStr -> E! I32

;; `low` hands a pointer to C, which may keep it. `high` never touches C
;; itself, but releasing in `high` would free what C is holding, so the taint
;; travels to the caller (spec §4.6).
low (s:&Str) : E! I32 = puts (to_cstr s)

high (s:&Str) : E! I32 = low s

clean (n:I32) : I32 = n + 1

main : E! Unit =
  n <- high "x"
  out (show (n + clean 1))
