mod Shadow

;; The arm rebinds `n`. Inheriting the signature's `n>0` here would discharge
;; the division for a value that has nothing to do with the parameter, which is
;; a false proof rather than an imprecise one.
type Err = Void

f (n:U64, n>0) (r:Res Err U64) : U64 =
  ?r |Er e -> 0
     |Ok n -> 100 / n
  end
