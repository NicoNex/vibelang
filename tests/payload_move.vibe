mod PayloadMove

;; The payload leaves with the result, so `found` must not be freed behind it.
keep (found:Opt Str) (fallback:Str) : Opt Str =
  ?found |Some x -> Some x
         |None   -> Some fallback
  end

;; A self-tail-call inside a nested match: `c` and `acc` are freed once, not
;; once by the back edge and again by the enclosing `let` and arm.
walk (s:&Str) (i:Size) (acc:Str) : Str =
  ?i |0 -> acc
     |_ -> let c = concat s "-" in
           ?c |"" -> acc
              |_  -> walk s (i - 1) (concat &acc &c)
           end
  end

;; `acc` goes to `fold`, which hands it to `grow`, even though the fold itself
;; sits in a position `fmt` only reads.
grow (acc:Str) (k:Size) : Str = concat &acc "+"

folded (s:Str) : Str =
  let acc = concat &s "" in
  fmt "{}" (fold grow acc &(range 0 3))

;; Each arm updates `c` in place; neither sees the other's update.
type Counter = { hits:U64, misses:U64 }

tally (c:Counter) (hit:Bool) : Counter =
  ?hit |True  -> {c with hits=1}
       |False -> {c with misses=c.hits}
  end

main : E! Unit =
  ?keep (Some (dup "kept")) "none" |Some v -> out &v |None -> out "lost" end ;
  out (fmt " {} {}\n" (walk "a" 3 "") (folded "x"))
