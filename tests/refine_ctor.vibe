mod RefineCtor

type Err = Void

head (v:&Vec U64, len v>0) : U64 = get v 0

pick (r:&Res Err (Vec U64)) : U64 =
  ?r |Er e  -> 0
     |Ok [] -> 0
     |Ok xs -> head xs
  end

type Tx  = { qty:U32, qty>0 }
type Box = B Tx

rate (b:&Box) : U32 =
  ?b |B t -> 100 / t.qty
  end

;; the payload's type is the variable `t` of `Res e t`, so `Tx`'s invariant
;; reaches the arm only once the scrutinee's arguments are substituted in
part (r:&Res Err Tx) : U32 =
  ?r |Er e -> 0
     |Ok t -> 100 / t.qty
  end
