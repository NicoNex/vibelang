mod Diff

;; The Vibelang side of the differential test against Go's regexp; see main.go.
spans (ms:&Vec (Size, Size)) : Str =
  fold (\acc m -> push_str acc &(span &m)) "" ms

span (m:&(Size, Size)) : Str =
  ?m |(a, b) -> fmt "{}-{} " a b
  end

group_text (g:&Opt Str) : Str =
  ?g |Some t -> fmt "[{}]" t
     |None   -> "-"
  end

caps (o:&Opt (Vec (Opt Str))) : Str =
  ?o |Some gs -> fold (\acc g -> push_str acc &(group_text &g)) "" gs
     |None    -> "nil"
  end

bracketed (ps:&Vec Str) : Str =
  fold (\acc p -> push_str acc &(fmt "[{}]" p)) "" ps

line (ln:&Str) : E! Unit =
  let rec = ?starts_with ln "\n" |True -> cut_first ln |False -> dup ln end in
  ?split '\t' &rec
   |[pat,s,tpl] -> out "@@" ;
                   ?Regex.compile &pat
                    |Er e  -> out "ERR"
                    |Ok re -> out &(fmt "{}|{}|{}|{}" (spans &(Regex.find_all &s &re)) (caps &(Regex.captures &s &re)) (Regex.replace &s &re &tpl) (bracketed &(Regex.split &s &re)))
                   end
   |_           -> ()
  end

cut_first (s:&Str) : Str =
  ?slice 1 (len s) s
   |Some t -> t
   |None   -> ""
  end

main : E! Unit =
  args <- argv ;
  ?drop 1 args
   |[path] -> txt <- read &path ;
              each line &(split '~' &txt)
   |_      -> warn "usage: diff CORPUS"
  end
