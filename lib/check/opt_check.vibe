mod OptCheck

fail (what:Str) : E! Unit =
  warn (concat &what "\n") ;
  exit 1

expect (ok:Bool) (what:Str) : E! Unit =
  ?ok |True  -> ()
      |False -> fail what
  end

pair_sum (o:Opt (U64, U64)) : U64 =
  ?o |Some (a, b) -> a / 2 + b / 2
     |None        -> 0
  end

res_val (r:Res Str U64) : U64 =
  ?r |Ok x -> x
     |Er e -> 0
  end

err_len (r:&Res Str U64) : Size =
  ?r |Ok x -> 0
     |Er e -> len e
  end

main : E! Unit =
  expect (Opt.is_some &(Some 3)) "is_some Some" ;
  expect (Opt.is_some &None==False) "is_some None" ;
  expect (Opt.is_none &None) "is_none None" ;
  expect (Opt.is_none &(Some 1)==False) "is_none Some" ;
  expect (Opt.unwrap_or 7 (Some 3)==3) "unwrap_or Some" ;
  expect (Opt.unwrap_or 7 None==7) "unwrap_or None" ;
  expect (Opt.unwrap_or 0 (Opt.map (\x -> x / 2) (Some 10))==5) "map Some" ;
  expect (Opt.is_none &(Opt.map (\x -> x / 2) None)) "map None" ;
  expect (Opt.unwrap_or 0 (Opt.and_then (\x -> Opt.from_bool (x>5) x) (Some 9))==9) "and_then Some" ;
  expect (Opt.is_none &(Opt.and_then (\x -> Opt.from_bool (x>5) x) (Some 2))) "and_then filtered" ;
  expect (Opt.unwrap_or 0 (Opt.or_else (Some 4) None)==4) "or_else None" ;
  expect (Opt.unwrap_or 0 (Opt.or_else (Some 4) (Some 1))==1) "or_else Some" ;
  expect (Opt.unwrap_or 0 (Opt.filter (\x -> x>2) (Some 3))==3) "filter keep" ;
  expect (Opt.is_none &(Opt.filter (\x -> x>2) (Some 1))) "filter drop" ;
  expect (res_val (Opt.to_res (dup "none") (Some 8))==8) "to_res Some" ;
  expect (err_len &(Opt.to_res (dup "none") None)==4) "to_res None" ;
  expect (Opt.unwrap_or 0 (Opt.from_res (Opt.to_res (dup "e") (Some 6)))==6) "from_res Ok" ;
  expect (Opt.is_none &(Opt.from_res (Opt.to_res (dup "e") None))) "from_res Er" ;
  expect (Opt.is_some &(Opt.from_bool True 1)) "from_bool True" ;
  expect (Opt.is_none &(Opt.from_bool False 1)) "from_bool False" ;
  expect (pair_sum (Opt.zip (Some 4) (Some 6))==5) "zip Some" ;
  expect (Opt.is_none &(Opt.zip (Some 4) None)) "zip None" ;
  expect (Opt.unwrap_or 0 (Opt.flatten (Some (Some 2)))==2) "flatten Some Some" ;
  expect (Opt.is_none &(Opt.flatten (Some None))) "flatten Some None" ;
  expect (Opt.values [Some 1, None, Some 3]==[1, 3]) "values" ;
  expect (Opt.count_some &[Some 1, None, Some 3]==2) "count_some" ;
  expect (len &(Opt.values [Some (dup "a"), None])==1) "values Str" ;
  out "ok"
